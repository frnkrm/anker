# Alle Variablen sind optional. Ohne sie läuft Anker komplett offline.

# Supabase (Sync + PC-Stopp). Projekt-URL und anon/public key aus Supabase > Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Kalender. OAuth-Client-ID vom Typ "Webanwendung" (auch für Android als serverClientId nötig).
VITE_GOOGLE_WEB_CLIENT_ID=

# Basis-URL der Web-Version (für Magic-Link-Redirects), z. B. https://anker.netlify.app
VITE_PUBLIC_URL=

# Nur für GitHub Actions (Release-APK), NICHT in .env eintragen, sondern als GitHub Secrets:
# ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
